# ---- Core ----
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=change-me-to-a-64-char-random-string
DEBUG=false
ALLOWED_HOSTS=api.localrush.in,localhost
CSRF_TRUSTED_ORIGINS=https://api.localrush.in
CORS_ALLOWED_ORIGINS=https://admin.localrush.in
SITE_URL=https://api.localrush.in

# ---- Database / cache ----
DATABASE_URL=postgis://localrush:localrush@db:5432/localrush
DB_POOL=true
DB_POOL_MAX=10
# In production set REDIS_PASSWORD and use redis://:<password>@redis:6379/N
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
GUNICORN_WORKERS=4
CELERY_CONCURRENCY=4
BACKUP_KEEP_DAYS=14

# ---- JWT ----
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=30

# ---- OTP / SMS (provider: console | msg91 | twilio) ----
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ---- Payments (Razorpay) ----
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Firebase Cloud Messaging ----
# Path to a service-account JSON file mounted into the container. Leave blank to disable push.
FIREBASE_CREDENTIALS_FILE=/run/secrets/firebase.json

# ---- Mapping ----
OSRM_BASE_URL=http://osrm:5000
NOMINATIM_BASE_URL=http://nominatim:8080
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
MAP_ATTRIBUTION=© OpenStreetMap contributors, © OpenFreeMap

# ---- Media / storage (local | s3) ----
STORAGE_BACKEND=local
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MEDIA_URL=/media/

# ---- Observability ----
SENTRY_DSN=
LOG_LEVEL=INFO

# ---- Postgres container bootstrap ----
POSTGRES_DB=localrush
POSTGRES_USER=localrush
POSTGRES_PASSWORD=localrush
